.page {
  height: 100%;
  min-height: 100%;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

.rule-tip {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 28rpx;
  line-height: 1.5;
}

.section {
  margin-bottom: 48rpx;
}

.label {
  display: block;
  color: #666;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.picker {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.feeling-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
  box-sizing: border-box;
}

.feeling-input {
  flex: 1;
  font-size: 32rpx;
  height: 100%;
  border-bottom: 2rpx solid #e0e0e0;
  margin-right: 16rpx;
}

.feeling-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.feeling-suffix {
  font-size: 32rpx;
  color: #333;
  margin-left: 8rpx;
}

.btn-wrap {
  margin-top: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.btn {
  width: 380rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(145deg, #d4a574, #c4956a);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
}

.btn-constipation {
  width: 160rpx;
  background: linear-gradient(145deg, #d64545, #c03939);
  font-size: 30rpx;
}

.btn:active {
  opacity: 0.9;
}

.btn.disabled {
  opacity: 0.6;
}
