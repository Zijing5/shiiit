.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.shit-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.slogan {
  color: #666;
  font-size: 28rpx;
  margin-bottom: 80rpx;
}

.btn-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 圆角长方形按钮 */
.btn-rect {
  width: 400rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(145deg, #d4a574, #c4956a);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
}

.btn-rect:active {
  transform: scale(0.98);
  opacity: 0.95;
}
