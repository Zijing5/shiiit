.container {
  height: 100%;
  min-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.shit-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.slogan {
  color: #666;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.status-card {
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  margin-bottom: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.status-title {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.status-sub {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.45;
}

.streak {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #2d8a3e;
}

.btn-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 圆角长方形按钮 */
.btn-rect {
  width: 400rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(145deg, #d4a574, #c4956a);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
}

.btn-rect:active {
  transform: scale(0.98);
  opacity: 0.95;
}

.sub-wrap {
  margin-top: 14rpx;
}

.btn-sub {
  width: 340rpx;
  height: 74rpx;
  border-radius: 37rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.08);
}

.view-btn {
  background: linear-gradient(145deg, #88b277, #6f9a5f);
  color: #fff;
}

.calendar-btn {
  background: linear-gradient(145deg, #d7c8b8, #c8b7a5);
  color: #6a5440;
}
