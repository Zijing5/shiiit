.page {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding: 0 16rpx;
}

.nav-btn {
  font-size: 48rpx;
  color: #c4956a;
  padding: 16rpx;
  font-weight: bold;
}

.month-label {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.weekdays {
  display: flex;
  margin-bottom: 16rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 14.28%;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 12rpx;
}

.day-num {
  font-size: 28rpx;
  color: #333;
}

.cell.today .day-num {
  color: #c4956a;
  font-weight: bold;
}

.cell.today {
  background: rgba(196, 149, 106, 0.15);
}

.check {
  position: absolute;
  bottom: 8rpx;
  font-size: 24rpx;
  color: #2d8a3e;
  font-weight: bold;
}

.cell.checked .day-num {
  color: #2d8a3e;
}

.bottom-btn-wrap {
  margin-top: 48rpx;
  padding: 0 24rpx 32rpx;
}

.bottom-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(145deg, #d4a574, #c4956a);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
}

.bottom-btn:active {
  opacity: 0.9;
}
