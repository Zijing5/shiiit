<view class="page">
  <view class="header">
    <text class="nav-btn" bindtap="prevMonth">‹</text>
    <text class="month-label">{{monthLabel}}</text>
    <text class="nav-btn" bindtap="nextMonth">›</text>
  </view>
  <view class="weekdays">
    <block wx:for="{{weekLabels}}" wx:key="*this">
      <text class="weekday">{{item}}</text>
    </block>
  </view>
  <view class="grid">
    <block wx:for="{{cells}}" wx:key="index">
      <view class="cell {{item.isToday ? 'today' : ''}} {{item.checked ? 'checked' : ''}} {{item.hasConstipation ? 'constipation' : ''}}" data-day="{{item.day}}" bindtap="onTapDay">
        <text wx:if="{{item.day}}" class="day-num">{{item.day}}</text>
        <text wx:if="{{item.day && item.checked}}" class="check {{item.hasConstipation ? 'constipation' : ''}}">{{item.count > 1 ? ('x' + item.count) : '✓'}}</text>
      </view>
    </block>
  </view>
  <view class="bottom-btn-wrap">
    <view class="bottom-btn" bindtap="onShareToday">分享今日拉屎成就</view>
  </view>

  <view wx:if="{{detailVisible}}" class="mask" bindtap="closeDetail"></view>
  <view wx:if="{{detailVisible}}" class="detail-panel">
    <view class="detail-head">
      <text class="detail-date">{{selectedDate}}</text>
      <text class="detail-close" bindtap="closeDetail">关闭</text>
    </view>
    <text class="detail-summary">{{selectedSummary}}</text>
    <view wx:if="{{!selectedRecords.length}}" class="empty">暂无记录</view>
    <block wx:for="{{selectedRecords}}" wx:key="id">
      <view class="record-item">
        <view class="record-info">
          <text class="record-line">时间：{{item.timeText}}</text>
          <text class="record-line">形状：{{item.shape}}｜份量：{{item.amount}}</text>
          <text class="record-line">感想：{{item.feeling}}</text>
        </view>
        <view class="del-btn" data-id="{{item.id}}" bindtap="onDeleteRecord">删除</view>
      </view>
    </block>
  </view>
</view>
