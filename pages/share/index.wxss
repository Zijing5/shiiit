.page {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top) + 44px);
  box-sizing: border-box;
  background: #f8f4f0;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: calc(env(safe-area-inset-top) + 44px);
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 0 24rpx 8rpx;
  padding-right: calc(24rpx + env(safe-area-inset-right));
  box-sizing: border-box;
  z-index: 10;
}

.close-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-wrap:active {
  background: rgba(0,0,0,0.12);
}

.close-icon {
  font-size: 44rpx;
  color: #666;
  line-height: 1;
  font-weight: 300;
}

.loading {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.share-preview {
  width: 100%;
  border-radius: 16rpx;
  background: #fff;
  max-height: 60vh;
}

.share-btns {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  gap: 24rpx;
}

.share-btn {
  flex: 1;
  padding: 24rpx 32rpx;
  background: linear-gradient(145deg, #d4a574, #c4956a);
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  text-align: center;
  border: none;
  margin: 0;
}

button.share-btn {
  line-height: 1.4;
}

button.share-btn::after {
  border: none;
}

.share-btn.right {
  background: #e8d5c4;
  color: #666;
}

.canvas-off {
  position: fixed;
  left: 0;
  top: 0;
  width: 375px;
  height: 500px;
  z-index: -1;
  opacity: 0;
  pointer-events: none;
}
