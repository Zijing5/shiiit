.page {
  height: 100%;
  min-height: 100%;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.title {
  display: block;
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.rule {
  display: block;
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.label {
  color: #888;
  font-size: 28rpx;
}

.value {
  color: #333;
  font-size: 30rpx;
  font-weight: 500;
}

.actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
}

.btn.primary {
  background: linear-gradient(145deg, #d4a574, #c4956a);
  color: #fff;
}

.btn.secondary {
  background: #eee2d7;
  color: #6f5a46;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 20;
}

.share-popup {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  z-index: 21;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.16);
}

.popup-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.popup-sub {
  display: block;
  text-align: center;
  margin-top: 6rpx;
  color: #999;
  font-size: 24rpx;
}

.loading {
  margin-top: 24rpx;
  text-align: center;
  color: #888;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.preview {
  width: 100%;
  margin-top: 18rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
  max-height: 58vh;
}

.popup-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.pop-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}

.pop-btn.primary {
  background: linear-gradient(145deg, #d4a574, #c4956a);
  color: #fff;
}

.pop-btn.secondary {
  background: #eee2d7;
  color: #6f5a46;
}

.canvas-off {
  position: fixed;
  left: 0;
  top: 0;
  z-index: -1;
  opacity: 0;
  pointer-events: none;
}
